<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="130dp" android:layout_margin="4dp">
    <ImageView android:id="@+id/thumb" android:scaleType="centerCrop"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
    <TextView android:id="@+id/video" android:text="▶" android:textSize="28sp"
        android:gravity="center" android:textColor="@android:color/white"
        android:background="#66000000" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
</FrameLayout>
